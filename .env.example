DISCORD_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/mydb?schema=public

# Development only — guild where the core commands are registered instantly
# (avoids the ~1h propagation of global commands). Required when running `pnpm dev`.
DEV_GUILD_ID=

# Optional in development — encrypts the copies of reported messages
# (`openssl rand -base64 32`). Required in production.
DATA_ENCRYPTION_KEY=
