# Production environment for compose.prod.yaml.
# Copy to .env.prod, fill in, keep it out of git (already gitignored).
#
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d

# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional: fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=info

# Optional: push URL of an Uptime Kuma "Push" monitor, as copied from Uptime
# Kuma. Secret: its token is enough to report a status. Empty: no monitoring.
UPTIME_KUMA_PUSH_URL=


# PostgreSQL credentials — DATABASE_URL is assembled from them in the compose
# file, so the database is never reachable from outside the internal network.
POSTGRES_USER=omnibot
POSTGRES_PASSWORD=
POSTGRES_DB=omnibot
