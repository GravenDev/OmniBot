{
  "name": "omni-bot",
  "private": true,
  "description": "Modular Discord bot whose modules are installed per guild",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc",
    "dev": "NODE_ENV=development node --conditions=development --env-file=.env --import tsx ./bootstrap/validate-env-vars.ts && NODE_ENV=development node --conditions=development --env-file=.env --import tsx src/index.ts",
    "start": "node ./bootstrap/validate-env-vars.ts && node ./dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "prepare": "lefthook install -f || true",
    "format": "oxfmt --write && oxlint --fix --fix-suggestions",
    "new-module": "node scripts/new-module.ts",
    "render-preview": "node scripts/render-preview.ts",
    "copy-check": "node scripts/copy-check.ts",
    "find-similar": "node scripts/find-similar.ts",
    "prisma:generate": "prisma generate --no-hints",
    "prisma:migrate": "prisma migrate dev && prisma generate --no-hints",
    "prisma:studio": "prisma studio --no-hints"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "1.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "croner": "11.0.0",
    "discord.js": "14.27.0",
    "emojibase-data": "18.0.0",
    "i18next": "26.7.2",
    "pino": "10.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "lefthook": "2.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pino-pretty": "13.2.0",
    "prisma": "catalog:",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.17.0"
}
