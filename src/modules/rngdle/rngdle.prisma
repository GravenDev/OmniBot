model RngdleAccount {
  guildId  String
  userId   String
  username String

  @@id([guildId, userId])
}

model RngdleRoll {
  guildId    String
  rollId     String
  userId     String
  number     Int
  score      BigInt
  badgeCount Int      @default(0)
  rolledAt   DateTime

  @@id([guildId, rollId])
  @@index([guildId, rolledAt])
  @@index([guildId, userId, rolledAt])
}

model RngdleScoreTable {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model RngdleReminder {
  guildId String
  userId  String

  @@id([guildId, userId])
}

// One verified card per member, per UTC day and per server.
model RngdleCardClaim {
  guildId String
  userId  String
  day     DateTime @db.Date

  @@id([guildId, userId, day])
}
