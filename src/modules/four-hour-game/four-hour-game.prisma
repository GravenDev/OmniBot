model FourHourGameScore {
  guildId String
  userId  String
  score   Int

  @@id([guildId, userId])
}

model FourHourGameLastMessage {
  guildId   String   @id
  channelId String
  messageId String
  authorId  String
  sentAt    DateTime
}

model FourHourGamePoint {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  heldSeconds Int
  awardedAt   DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, awardedAt])
}

model FourHourGameDailyBest {
  guildId     String
  day         String
  userId      String
  heldSeconds Int

  @@id([guildId, day])
  @@index([guildId, userId])
}

model FourHourGameDailyState {
  guildId   String @id
  closedDay String
}
