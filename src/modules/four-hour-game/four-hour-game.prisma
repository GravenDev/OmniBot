model FourHourGameScore {
  guildId String
  userId  String
  score   Int

  @@id([guildId, userId])
}

model FourHourGameLastMessage {
  guildId   String   @id
  channelId String
  messageId String
  authorId  String
  sentAt    DateTime
  // No 4h point counts time before it: the last point of the server, or when
  // the game took this message up. A message back in place after a deletion
  // keeps it, so it cannot score twice for the same time.
  scoringFrom DateTime
}

model FourHourGamePoint {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  heldSeconds Int
  awardedAt   DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, awardedAt])
}

model FourHourGameDailyBest {
  guildId     String
  day         String
  userId      String
  heldSeconds Int

  @@id([guildId, day])
  @@index([guildId, userId])
}

model FourHourGameDailyState {
  guildId   String @id
  closedDay String
}
