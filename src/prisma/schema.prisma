
// === Modèles de core/models/config.prisma ===
model GuildConfiguration {
  guildId String @id
  data    Json
}

// === Modèles de core/models/mentions.prisma ===
model MentionOptOut {
  guildId String
  userId  String

  @@id([guildId, userId])
}

// === Modèles de core/models/modules.prisma ===
model ModuleActivation {
  moduleId String
  guildId  String

  activated        Boolean
  activatedVersion String  @default("")

  @@id([moduleId, guildId])
}

// === Modèles de modules/four-hour-game/four-hour-game.prisma ===
model FourHourGameScore {
  guildId String
  userId  String
  score   Int

  @@id([guildId, userId])
}

model FourHourGameLastMessage {
  guildId   String   @id
  channelId String
  messageId String
  authorId  String
  sentAt    DateTime
}

model FourHourGamePoint {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  heldSeconds Int
  awardedAt   DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, awardedAt])
}

// === Modèles de modules/reports/reports.prisma ===
model MessageReport {
  id               Int       @id @default(autoincrement())
  guildId          String
  channelId        String
  messageId        String
  authorId         String
  content          String
  attachments      Json
  messageCreatedAt DateTime
  messageState     String    @default("present")
  editedContent    String?
  reactionKept     Boolean   @default(false)
  alertChannelId   String?
  alertMessageId   String?
  status           String    @default("open")
  handledBy        String?
  handledAt        DateTime?
  createdAt        DateTime  @default(now())

  reporters MessageReporter[]
  actions   ReportAction[]

  @@unique([guildId, messageId])
  @@index([guildId, authorId])
  @@index([status, handledAt])
}

model MessageReporter {
  reportId   Int
  userId     String
  source     String
  reason     String?
  reportedAt DateTime @default(now())

  report MessageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
}

model ReportAction {
  id          Int      @id @default(autoincrement())
  reportId    Int
  moderatorId String
  action      String
  reason      String?
  duration    Int?
  failed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  report MessageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// === Modèles de modules/rngdle/rngdle.prisma ===
model RngdleAccount {
  guildId  String
  userId   String
  username String

  @@id([guildId, userId])
}

model RngdleRoll {
  guildId    String
  rollId     String
  userId     String
  number     Int
  score      BigInt
  badgeCount Int      @default(0)
  rolledAt   DateTime

  @@id([guildId, rollId])
  @@index([guildId, rolledAt])
  @@index([guildId, userId])
}

model RngdleScoreTable {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model RngdleReminder {
  guildId String
  userId  String

  @@id([guildId, userId])
}
