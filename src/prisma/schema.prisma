
// === Modèles de core/models/config.prisma ===
model GuildConfiguration {
  guildId String @id
  data    Json
}

// === Modèles de core/models/mentions.prisma ===
model MentionOptOut {
  guildId String
  userId  String

  @@id([guildId, userId])
}

// === Modèles de core/models/modules.prisma ===
model ModuleActivation {
  moduleId String
  guildId  String

  activated        Boolean
  activatedVersion String  @default("")

  @@id([moduleId, guildId])
}

// === Modèles de modules/four-hour-game/four-hour-game.prisma ===
model FourHourGameScore {
  guildId String
  userId  String
  score   Int

  @@id([guildId, userId])
}

model FourHourGameLastMessage {
  guildId   String   @id
  channelId String
  messageId String
  authorId  String
  sentAt    DateTime
}

model FourHourGamePoint {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  heldSeconds Int
  awardedAt   DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, awardedAt])
}

// === Modèles de modules/rngdle/rngdle.prisma ===
model RngdleAccount {
  guildId  String
  userId   String
  username String

  @@id([guildId, userId])
}

model RngdleRoll {
  guildId    String
  rollId     String
  userId     String
  number     Int
  score      BigInt
  badgeCount Int      @default(0)
  rolledAt   DateTime

  @@id([guildId, rollId])
  @@index([guildId, rolledAt])
  @@index([guildId, userId])
}

model RngdleScoreTable {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model RngdleReminder {
  guildId String
  userId  String

  @@id([guildId, userId])
}

// === Modèles de modules/server-stats/server-stats.prisma ===
model ServerStatsGuild {
  guildId   String   @id
  startedAt DateTime @default(now())
}

model ServerStatsDay {
  guildId String
  day     DateTime @db.Date
  joins   Int      @default(0)
  leaves  Int      @default(0)

  @@id([guildId, day])
  @@index([day])
}

model ServerStatsChannel {
  guildId   String
  day       DateTime @db.Date
  channelId String
  messages  Int      @default(0)

  @@id([guildId, day, channelId])
  @@index([day])
}

model ServerStatsMember {
  guildId  String
  day      DateTime @db.Date
  userId   String
  messages Int      @default(0)

  @@id([guildId, day, userId])
  @@index([day])
}

model ServerStatsReaction {
  guildId   String
  day       DateTime @db.Date
  emoji     String
  reactions Int      @default(0)

  @@id([guildId, day, emoji])
  @@index([day])
}
