
// === Modèles de core/models/config.prisma ===
model GuildConfiguration {
  guildId String @id
  data    Json
}

// === Modèles de core/models/modules.prisma ===
model ModuleActivation {
  moduleId String
  guildId  String

  activated        Boolean
  activatedVersion String  @default("")

  @@id([moduleId, guildId])
}

// === Modèles de modules/four-hour-game/four-hour-game.prisma ===
model FourHourGameScore {
  guildId String
  userId  String
  score   Int

  @@id([guildId, userId])
}

model FourHourGameLastMessage {
  guildId   String   @id
  channelId String
  messageId String
  authorId  String
  sentAt    DateTime
}

// === Modèles de modules/rngdle/rngdle.prisma ===
model RngdleAccount {
  guildId  String
  userId   String
  username String

  @@id([guildId, userId])
}

model RngdleRoll {
  guildId    String
  rollId     String
  userId     String
  number     Int
  score      BigInt
  badgeCount Int      @default(0)
  rolledAt   DateTime

  @@id([guildId, rollId])
  @@index([guildId, rolledAt])
  @@index([guildId, userId])
}

model RngdleScoreTable {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}
